---

<Layout title="Resume | Ripusudan Vishwakarma">
  <main class="container resume-page">
    <section class="page-head resume-intro">
      <div class="eyebrow">Resume</div>
      <h1>Ripusudan Vishwakarma</h1>
      <p class="muted">Platform Engineer | AWS | Cloud | DevOps</p>
    </section>

    <div class="resume-shell">
      <aside class="resume-sidebar">
        <div class="resume-profile-card">
          <div class="avatar">RV</div>
          <div>
            <span class="eyebrow soft">Platform Engineer</span>
            <h2>Ripusudan Vishwakarma</h2>
          </div>
        </div>

        <div class="resume-panel">
          <h3>Contact</h3>
          <ul class="contact-list">
            <li>
              <strong>Email</strong>
              <span><a href="mailto:sudan.ripu83@gmail.com">sudan.ripu83@gmail.com</a></span>
            </li>
            <li>
              <strong>Phone</strong>
              <span><a href="tel:+918889390068">+91 8889390068</a></span>
            </li>
            <li>
              <strong>Location</strong>
              <span>Bengaluru, India</span>
            </li>
            <li>
              <strong>Profiles</strong>
              <span><a href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a></span>
            </li>
          </ul>
        </div>

        <div class="resume-panel">
          <h3>Skills</h3>
          <div class="skills compact">
            {skillGroups.flatMap((group) => group.items).slice(0, 18).map((skill) => (
              <span class="skill">{skill}</span>
            ))}
          </div>
        </div>

        <div class="resume-panel">
          <h3>Tools &amp; Platforms</h3>
          <div class="skills compact tool-tags">
            {technologies.map((tech) => (
              <span class="tool-tag">{tech}</span>
            ))}
          </div>
        </div>

        <div class="resume-panel">
          <h3>Certifications</h3>
          <div class="cert-stack">
            {certifications.map((cert) => (
              <div class="cert-mini">
                <div class="cert-mini-badge">{cert.badge}</div>
                <div>
                  <strong>{cert.name}</strong>
                  <span>Certification</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="resume-panel">
          <h3>Hobbies</h3>
          <ul class="simple-list">
            <li>Cloud architecture research</li>
            <li>Automation and systems thinking</li>
            <li>Continuous learning</li>
            <li>Problem solving</li>
          </ul>
        </div>
      </aside>

      <div class="resume-main">
        <section class="resume-panel highlight-panel">
          <div class="panel-header">
            <span class="eyebrow">Professional Summary</span>
          </div>
          <p>
            Platform Engineer with 5 years of experience in AWS cloud infrastructure, platform engineering, DevOps and cloud security. Experienced in designing and automating secure, scalable AWS platforms using AWS CDK, Terraform, CloudFormation and CI/CD. Strong experience across AWS Identity and Access Management, Microsoft Active Directory, AWS Organizations, cross-account access, networking, infrastructure automation and deployment governance.
          </p>
        </section>

        <section class="resume-panel">
          <div class="panel-header">
            <span class="eyebrow">Career</span>
            <h2>Experience</h2>
          </div>

          <div class="timeline">
            {experience.map((item) => (
              <article class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content">
                  <div class="exp-header">
                    <div class={`company-badge ${item.className}`}>{item.badge}</div>
                    <div>
                      <h3>{item.company}</h3>
                      <p>{item.role}</p>
                    </div>
                  </div>

                  <div class="company-meta">
                    <span>{item.location}</span>
                    <span>{item.duration}</span>
                  </div>

                  <div class="resume-subsection">
                    <h4>Project Experience</h4>
                    <ul class="exp-list">
                      {item.highlights.map((entry) => (
                        <li>{entry}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="resume-subsection">
                    <h4>Other Responsibilities</h4>
                    <ul class="exp-list">
                      {item.responsibilities.map((entry) => (
                        <li>{entry}</li>
                      ))}
                    </ul>
                  </div>

                  {item.recognition && (
                    <div class="resume-subsection recognition">
                      <h4>Recognition</h4>
                      <p>{item.recognition}</p>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="resume-panel">
          <div class="panel-header">
            <span class="eyebrow">Education</span>
            <h2>Academics</h2>
          </div>

          <div class="mini-grid">
            <div class="mini-card">
              <h3>B.Tech</h3>
              <p>Bhilai Institute of Technology, Durg</p>
              <span>2020</span>
            </div>

            <div class="mini-card">
              <h3>HSC</h3>
              <p>Oriental Public School, Ambikapur</p>
              <span>2015</span>
            </div>
          </div>
        </section>

        <section class="resume-panel">
          <div class="panel-header">
            <span class="eyebrow">Projects</span>
            <h2>Academic Work</h2>
          </div>

          <ul class="resume-list">
            <li>CLI Based Quiz Application with Multi-User Access and Result Analytics</li>
            <li>HTML Link Status Checker with Console Output and Chart Visualization</li>
            <li>Health Monitoring System using ESP32 Arduino and SIM800L with SMS alerts</li>
          </ul>
        </section>

        <section class="resume-panel">
          <div class="panel-header">
            <span class="eyebrow">Leadership</span>
            <h2>Experience</h2>
          </div>

          <div class="mini-grid">
            <div class="mini-card">
              <h3>Member, Core Organizing Committee</h3>
              <p>OJAS - College TechFest</p>
              <span>2018, 2019</span>
            </div>

            <div class="mini-card">
              <h3>Head Boy of School</h3>
              <span>2014, 2015</span>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>
</Layout>
