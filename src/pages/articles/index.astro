---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <main>
    <section class="section">
      <div class="container">
        <div class="eyebrow">Knowledge Base</div>

        <h1>Articles</h1>

        <p class="lead">
          Practical notes on Platform Engineering, AWS, DevSecOps,
          cloud security, automation and AI/GenAI.
        </p>

        <div class="article-grid">
          {posts.map((post) => (
            <a class="card" href={`${base}articles/${post.id}/`}>
              <div class="tag">{post.data.category}</div>

              <h2>{post.data.title}</h2>

              <p>{post.data.description}</p>

              <div class="meta">
                {post.data.date.toLocaleDateString("en-IN")}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>